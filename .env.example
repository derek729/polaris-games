# 두마당 서버 환경변수 자리표시 — 실값을 이 파일에 넣어 커밋하지 마세요.
# 시크릿(AUTH_SALT)은 Railway Variables에만 등록합니다. (docs/design/portal-phase2-account-server.md §8-4)

# 서버 포트 (Railway는 자동 주입 — 로컬 기동 시에만 필요)
PORT=8787

# 데이터 디렉터리 (Railway 볼륨 마운트 지점: /data)
DATA_DIR=./data

# scrypt 페퍼 — 필수. 발급: openssl rand -hex 32  (분실 시 기존 비밀번호 전부 검증 불가)
AUTH_SALT=__REPLACE_WITH_openssl_rand_hex_32__

# --- 선택 (아래는 기본값 그대로면 설정 불필요) ---
# 허용 CORS Origin 콤마 목록 (GitHub Pages + 필요 시 Railway 자기 origin 추가)
CORS_ORIGIN=https://derek729.github.io
# 토큰 유효 기간(일)
TOKEN_TTL_DAYS=30
# 주 시작 계산 타임존 오프셋(분) — 540 = UTC+9 (KST)
WEEKLY_TZ_OFFSET_MIN=540
# 레이트 리미트 (분당) — 계정당 / IP당
RATE_LIMIT_ACCOUNT_PER_MIN=60
RATE_LIMIT_IP_PER_MIN=120
